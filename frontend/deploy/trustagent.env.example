# Copy to /etc/trustagent.env and fill in. Keep this file private: sudo chmod 600 /etc/trustagent.env
TRUSTAGENT_PUBLIC=1
# The exact address people open, without a trailing slash.
TRUSTAGENT_ORIGIN=http://YOUR-SERVER-IP:8787
# Operator code, at least 12 characters. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
TRUSTAGENT_ACCESS_CODE=change-me-to-a-long-random-code
# Optional: OAuth identities that may run agents (github:<login>, google:<email>, aws:<email>).
# TRUSTAGENT_OPERATORS=github:your-login
# Optional limits (defaults shown).
# TRUSTAGENT_RUN_COOLDOWN=60
# TRUSTAGENT_MAX_RUNS_PER_DAY=50
# TRUSTAGENT_MAX_EXTRA_AGENTS=4
# Set when a reverse proxy (Caddy, nginx, a load balancer) sits in front and adds X-Forwarded-For.
# TRUSTAGENT_TRUST_PROXY=1
