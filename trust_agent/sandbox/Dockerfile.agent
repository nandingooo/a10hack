FROM node:22-bookworm-slim
ARG CLAUDE_CODE_VERSION=2.1.319
COPY build-certs/ /usr/local/share/ca-certificates/airlock/
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
RUN apt-get update && apt-get install -y --no-install-recommends python3 git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates \
    && npm install --global @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
    && useradd --uid 10001 --create-home agent
COPY sandbox /opt/airlock/sandbox
RUN mkdir -p /etc/claude-code && python3 /opt/airlock/sandbox/managed_settings.py \
    && chmod -R a-w /opt/airlock /etc/claude-code
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/home/agent
USER 10001:10001
WORKDIR /work
CMD ["claude"]
